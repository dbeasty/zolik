# Production env for play.limidus.com (KDB single-container stack).
# Copied to server/.env on first deploy; edit in place on the server afterward.
#
# APP_ENV decides four defaults, and it is the most load-bearing line here.
# Anything other than "local" (or unset) counts as a real environment:
#
#   SSH_ENABLED            on -> off      the terminal client
#   SSH_ALLOW_ALL_KEYS     on -> off      "admit any key"
#   ENABLE_TEST_ENDPOINTS  on -> off      the two hatches described below
#   SMTP_*                 optional -> REQUIRED
#
# The first three get safer. The fourth is a hard requirement, and the reason
# this file used to say `local`: a real environment refuses to start without
# SMTP rather than silently swallowing sign-in codes (auth.NewMailer). Left
# unset, the container will not boot — it fatals on init and Docker restarts
# it forever, which is a failure that reads like anything but a missing
# variable. deploy.sh checks for exactly that before it builds anything.
#
# So: keep this at production, and set SMTP_* below before deploying. If you
# genuinely want guest-only play with no mail server, set APP_ENV=local and
# understand that the two hatches come back on unless the lines below hold
# them shut (they do, and the compose file holds them shut as well).

APP_ENV=production
PORT=8090

FEATURE_FLAG_DB_ENGINE=kdb
KDB_PATH=/data/kdb

JWT_ACCESS_SECRET=REPLACE_ON_FIRST_DEPLOY
JWT_REFRESH_SECRET=REPLACE_ON_FIRST_DEPLOY

PUBLIC_BASE_URL=https://play.limidus.com
AUTH_ALLOWED_RETURN_URLS=https://play.limidus.com,clientreactnative://

# SSH terminal client — disabled on the public host.
SSH_ENABLED=false
SSH_ALLOW_ALL_KEYS=false

# The two development hatches, shut.
#
# Redundant at APP_ENV=production, where they already default off — and kept
# anyway, because the value above is one edit away from `local` and these are
# not things that should switch back on as a side effect of someone turning
# off email sign-in.
#   /matches/{id}/debug-state  writes match state straight past the rules,
#                              so anyone could rewrite anyone's game.
#   /auth/dev/last-code        hands back the sign-in code mailed to any
#                              address — an account takeover the moment SMTP
#                              is configured below.
# The compose file shuts them too; this says it where the APP_ENV that opens
# them is set, so the two are read together.
ENABLE_TEST_ENDPOINTS=false

# Passwordless email sign-in. REQUIRED at the APP_ENV above — the server will
# not start without SMTP_HOST, and SMTP_FROM is required once SMTP_HOST is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=Žolíky
