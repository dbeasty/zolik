# Production-ish env for play.limidus.com (KDB single-container stack).
# Copied to server/.env on first deploy; edit in place on the server afterward.
#
# APP_ENV=local keeps guest sign-in working without SMTP. Switch to
# production and set SMTP_* when email sign-in is ready.

APP_ENV=local
PORT=8090

FEATURE_FLAG_DB_ENGINE=kdb
KDB_PATH=/data/kdb

JWT_ACCESS_SECRET=REPLACE_ON_FIRST_DEPLOY
JWT_REFRESH_SECRET=REPLACE_ON_FIRST_DEPLOY

PUBLIC_BASE_URL=https://play.limidus.com
AUTH_ALLOWED_RETURN_URLS=https://play.limidus.com,clientreactnative://

# SSH terminal client — disabled on the public host.
SSH_ENABLED=false
SSH_ALLOW_ALL_KEYS=false

# The two development hatches, shut.
#
# They are not off by default here: APP_ENV=local above (which this file sets
# deliberately, to keep guest sign-in working without SMTP) turns them ON.
#   /matches/{id}/debug-state  writes match state straight past the rules,
#                              so anyone could rewrite anyone's game.
#   /auth/dev/last-code        hands back the sign-in code mailed to any
#                              address — an account takeover the moment SMTP
#                              is configured below.
# The compose file shuts them too; this says it where the APP_ENV that opens
# them is set, so the two are read together.
ENABLE_TEST_ENDPOINTS=false

# Passwordless email sign-in (required when APP_ENV=production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=Žolíky
