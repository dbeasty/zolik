+//
+// A capture normally fills a hand, but not always. Laying the top card onto a
+// meld when it is the only card in the pile adds nothing, so a player holding
+// a single card would take it and then have no discard that is not going out
+// — the same dead end applyTakeTop refuses, reached by the other door.
+func captureLeavesPlayable(s *GameState, playerID string, opt pileOption) error {
+	r := s.rules()
+	t := s.team(playerID)
+	held, _ := removeCards(s.Hands[playerID], opt.Cards)
+	n := len(held)
+	for _, c := range s.DiscardPile[:len(s.DiscardPile)-1] {
+		if !isRedThree(c) {
+			n++
+		}
+	}
+
+	var into *Meld
+	if opt.MeldID != "" {
+		_, into = s.findMeld(opt.MeldID)
+	} else {
+		into = t.openGroup(r, rankOf(s.top()))
+	}
+	before := 0
+	if into != nil {
+		before = len(into.Cards)
+	}
+	after := before + 1 + len(opt.Cards)
+	canastas := t.canastas()
+	if before < canastaSize && after >= canastaSize {
+		canastas++
+	}
+	return leavesPlayable(n, canastas >= s.CanastasToGoOut)
+}
