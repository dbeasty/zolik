diff --git a/server/internal/canasta/pile_meld_capture_test.go b/server/internal/canasta/pile_meld_capture_test.go
index 8313b26b..e0e663ad 100644
--- a/server/internal/canasta/pile_meld_capture_test.go
+++ b/server/internal/canasta/pile_meld_capture_test.go
@@ -319,3 +319,134 @@ func TestRulesStateThePileCapture(t *testing.T) {
 		})
 	}
 }
+
+// A capture must leave the turn a way to end, as every other move must.
+//
+// Laying the top card onto a meld when it is the whole pile puts nothing in the
+// hand, so a player holding one card would take it and then have only a
+// discard that is going out — which a side without its canastas may not do.
+// The only move left was undoing the capture, and bots strip undos, so a bot
+// table stalled there. The offer is withheld, Apply refuses, and the disabled
+// control carries the refusal that is actually true.
+func TestCaptureThatWouldStrandTheHandIsRefused(t *testing.T) {
+	kings := func(s *GameState) {
+		s.Phase = phaseDraw
+		s.CanastasToGoOut = 1
+		s.Teams[0].HasMelded = true
+		s.Teams[0].Melds = []Meld{{
+			ID: meldID(0, "K"), TeamID: 0, Kind: meldSet, Rank: "K",
+			Cards: []string{"KS", "KC", "KD"},
+		}}
+		s.DiscardPile = []string{"KH"}
+		s.Hands["p1"] = []string{"8C"}
+	}
+	queens := func(s *GameState) {
+		s.Phase = phaseDraw
+		s.CanastasToGoOut = 1
+		s.Teams[0].HasMelded = true
+		s.Teams[0].Melds = []Meld{{
+			ID: meldID(0, "Q"), TeamID: 0, Kind: meldSet, Rank: "Q",
+			Cards: []string{"QS", "QC", "QD"},
+		}}
+		s.DiscardPile = []string{"KH"}
+	}
+	canasta := Meld{
+		ID: meldID(0, "7"), TeamID: 0, Kind: meldSet, Rank: "7",
+		Cards: []string{"7S", "7C", "7D", "7H", "7S", "7C", "7D"},
+	}
+
+	cases := []struct {
+		name   string
+		mutate func(s *GameState)
+		action module.Action
+		want   string
+	}{
+		{
+			name:   "onto a meld, holding one card",
+			mutate: kings,
+			action: module.Action{Verb: VerbTakePile, Target: meldID(0, "K")},
+			want:   ErrMustKeepACard,
+		},
+		{
+			name: "from hand, left holding one card",
+			mutate: func(s *GameState) {
+				queens(s)
+				s.Hands["p1"] = []string{"KC", "KD", "8C"}
+			},
+			action: module.Action{Verb: VerbTakePile, Cards: []string{"KC", "KD"}},
+			want:   ErrMustKeepACard,
+		},
+		{
+			name: "from hand, left holding nothing",
+			mutate: func(s *GameState) {
+				queens(s)
+				s.Hands["p1"] = []string{"KC", "KD"}
+			},
+			action: module.Action{Verb: VerbTakePile, Cards: []string{"KC", "KD"}},
+			want:   ErrCannotGoOutYet,
+		},
+		{
+			name: "a buried card is one to keep",
+			mutate: func(s *GameState) {
+				kings(s)
+				s.DiscardPile = []string{"5C", "KH"}
+			},
+			action: module.Action{Verb: VerbTakePile, Target: meldID(0, "K")},
+		},
+		{
+			name: "a buried red three is not",
+			mutate: func(s *GameState) {
+				kings(s)
+				s.DiscardPile = []string{"3H", "KH"}
+			},
+			action: module.Action{Verb: VerbTakePile, Target: meldID(0, "K")},
+			want:   ErrMustKeepACard,
+		},
+		{
+			name: "a side with its canastas may go down to one",
+			mutate: func(s *GameState) {
+				kings(s)
+				s.Teams[0].Melds = append(s.Teams[0].Melds, canasta)
+			},
+			action: module.Action{Verb: VerbTakePile, Target: meldID(0, "K")},
+		},
+		{
+			name: "a capture that completes the canasta counts it",
+			mutate: func(s *GameState) {
+				kings(s)
+				s.Teams[0].Melds[0].Cards = []string{"KS", "KC", "KD", "KS", "KC", "KD"}
+			},
+			action: module.Action{Verb: VerbTakePile, Target: meldID(0, "K")},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			raw := twoHanded(tc.mutate)
+
+			offers, err := New().LegalActions(raw, "p1")
+			if err != nil {
+				t.Fatal(err)
+			}
+			var enabled bool
+			for _, o := range offers {
+				if o.Verb == VerbTakePile && o.Enabled {
+					enabled = true
+				}
+			}
+			if enabled != (tc.want == "") {
+				t.Errorf("take_pile enabled = %v, want %v", enabled, tc.want == "")
+			}
+			if tc.want != "" {
+				o := offerByID(offers, OfferTakePile)
+				if o == nil || o.WhyNot != tc.want {
+					t.Errorf("disabled offer %+v, want WhyNot %s", o, tc.want)
+				}
+			}
+
+			if _, got := apply(t, raw, "p1", tc.action); got != tc.want {
+				t.Errorf("Apply: got %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
