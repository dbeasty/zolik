# API base URL (no trailing slash)
# iOS Simulator: http://127.0.0.1:8090
# Android Emulator: http://10.0.2.2:8090
# Physical device: http://<your-lan-ip>:8090
EXPO_PUBLIC_ZOLIK_BASE_URL=http://127.0.0.1:8090

# This file is read only when Expo is started directly (npm run web, npm start).
# scripts/dev-stack.sh exports EXPO_PUBLIC_ZOLIK_BASE_URL itself, and a value in
# the process environment beats a .env file — so editing this to reach the stack
# from another machine has no effect. Use the stack's own knob instead, and note
# it serves the API on 8096 rather than 8090:
#
#   ZOLIK_DEV_HOST=<your-lan-ip> scripts/dev-stack.sh up
