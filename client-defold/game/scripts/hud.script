local M = {}

local nodes = {}

function init(self)
	nodes = {
		offer_panel = gui.get_node("offer_panel"),
		offer_card_label = gui.get_node("offer_card_label"),
	}
	gui.set_enabled(nodes.offer_panel, false)
end

function on_message(self, message_id, message, sender)
	local t = tostring(message_id)
	if t == "render_hud" then
		-- v1 placeholder
	elseif t == "show_offer" then
		if nodes.offer_panel then
			gui.set_enabled(nodes.offer_panel, true)
		end
		if nodes.offer_card_label then
			gui.set_text(nodes.offer_card_label, tostring(message.card))
		end
	elseif t == "hide_offer" then
		if nodes.offer_panel then
			gui.set_enabled(nodes.offer_panel, false)
		end
	elseif t == "show_error" then
		-- v1 placeholder
	elseif t == "show_suspended" then
		-- v1 placeholder
	elseif t == "hide_suspended" then
		-- v1 placeholder
	end
end

function on_input(self, action_id, action)
	if action.pressed == false then return end
	if action_id == hash("accept_offer") then
		msg.post("/game#network", "accept_offer")
		msg.post("/game#hud", "hide_offer")
	elseif action_id == hash("decline_offer") then
		msg.post("/game#network", "decline_offer")
		msg.post("/game#hud", "hide_offer")
	end
end

return M

