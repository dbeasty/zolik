local websocket = require("websocket")

local M = {}

local ws_connection = nil
local reconnect_timer = nil
local RECONNECT_DELAY = 3

M.server_url = nil
M.token = nil

local function schedule_reconnect()
	if reconnect_timer then
		timer.cancel(reconnect_timer)
		reconnect_timer = nil
	end
	reconnect_timer = timer.delay(RECONNECT_DELAY, false, function()
		if M.server_url and M.token then
			local ws_url = M.server_url .. "?token=" .. M.token
			ws_connection = websocket.connect(ws_url, {}, function(conn, data)
				if data.event == websocket.EVENT_CONNECTED then
					msg.post("/game#game_state", "ws_connected")
				elseif data.event == websocket.EVENT_DISCONNECTED then
					schedule_reconnect()
				elseif data.event == websocket.EVENT_MESSAGE then
					local msg_data = json.decode(data.message)
					msg.post("/game#" .. msg_data.type, "server_msg", msg_data)
				elseif data.event == websocket.EVENT_ERROR then
					print("WS error: " .. tostring(data.message))
				end
			end)
		end
	end)
end

local function connect()
	if not M.server_url or not M.token then
		return
	end
	local ws_url = M.server_url .. "?token=" .. M.token
	ws_connection = websocket.connect(ws_url, {}, function(conn, data)
		if data.event == websocket.EVENT_CONNECTED then
			msg.post("/game#game_state", "ws_connected")
		elseif data.event == websocket.EVENT_DISCONNECTED then
			schedule_reconnect()
		elseif data.event == websocket.EVENT_MESSAGE then
			local msg_data = json.decode(data.message)
			msg.post("/game#" .. msg_data.type, "server_msg", msg_data)
		elseif data.event == websocket.EVENT_ERROR then
			print("WS error: " .. tostring(data.message))
		end
	end)
end

local function send(payload)
	if ws_connection then
		websocket.send(ws_connection, json.encode(payload))
	end
end

-- Public API
function M.setServerAndToken(server_url, token)
	M.server_url = server_url
	M.token = token
	connect()
end

function M.draw_card(from)
	send({ type = "draw_card", from = from })
end

function M.accept_offer()
	send({ type = "accept_offer" })
end

function M.decline_offer()
	send({ type = "decline_offer" })
end

function M.lay_meld(cards)
	send({ type = "lay_meld", cards = cards })
end

function M.lay_off(meld_id, card)
	send({ type = "lay_off", meldId = meld_id, card = card })
end

function M.discard(card)
	send({ type = "discard", card = card })
end

return M

