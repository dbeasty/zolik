local M = {}

local selected = {}
local current_cards = {}

local function deselect_all()
	selected = {}
end

function on_message(self, message_id, message, sender)
	local t = tostring(message_id)
	if t == "render_hand" then
		current_cards = message.cards or {}
		selected = {}
		-- v1 placeholder: actual card object spawning handled in Defold GUI/layout
	elseif t == "card_selection_changed" then
		selected[message.card] = message.selected
	end
end

-- v1: return selected cards to HUD via a message.
function M.getSelectedCards()
	local out = {}
	for card, isSel in pairs(selected) do
		if isSel then table.insert(out, card) end
	end
	return out
end

return M

