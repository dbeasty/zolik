local M = {}

local selected = false
local card_id = nil

function init(self)
	msg.post(".", "acquire_input_focus")
end

function on_message(self, message_id, message, sender)
	local t = tostring(message_id)
	if t == "set_card" then
		card_id = message.card
		-- v1 placeholder: actual sprite/atlas frame switching in GUI
	elseif t == "deselect" then
		selected = false
	end
end

function on_input(self, action_id, action)
	if action.pressed == false then return end
	selected = not selected
	msg.post("/game#hand", "card_selection_changed", { card = card_id, selected = selected })
end

return M

