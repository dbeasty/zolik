[project]
title = Zoliky
version = 1.0.0
dependencies#0 = https://github.com/defold/extension-websocket/archive/refs/tags/4.2.2.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 900
height = 800
high_dpi = 0
clear_color = 0.12, 0.12, 0.14, 1

[script]
shared_state = 

[android]
input_method = HiddenInputField

[ios]
bundle_name = Zoliky

[osx]
bundle_name = Zoliky

[html5]
scale_mode = stretch

[zolik]
debug_gui = 1
