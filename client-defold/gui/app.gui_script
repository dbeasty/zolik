-- Playable lobby + in-game UI for Žolíky.

-- vmath is a Defold built-in (no require needed in GUI scripts)
local api = require("game.scripts.api")
local ws = require("game.scripts.ws_client")

-- Logging: prints to the Defold console / HTML5 browser devtools.
-- Silence: in game.project set [zolik] debug_gui = 0
local function debug_gui()
	return sys.get_config("zolik.debug_gui") ~= "0"
end

local function dlog(...)
	if not debug_gui() then
		return
	end
	print("[zolik_gui]", ...)
end

local function log_display(tag)
	local rw, rh, ww, wh
	pcall(function()
		rw = render.get_width()
		rh = render.get_height()
	end)
	pcall(function()
		ww = render.get_window_width()
		wh = render.get_window_height()
	end)
	local wok, ws, hs = pcall(window.get_size)
	if not wok then
		ws, hs = nil, nil
	end
	local dscale
	local ds_ok, ds_or_err = pcall(window.get_display_scale)
	if ds_ok then
		dscale = ds_or_err
	end
	dlog(tag, "render", tostring(rw), "x", tostring(rh), "render_window", tostring(ww), "x", tostring(wh))
	dlog(tag, "window.get_size", tostring(ws), "x", tostring(hs), "display_scale", tostring(dscale))
	local info = sys.get_sys_info()
	dlog(tag, "sys", tostring(info.system_name), tostring(info.device_model))
end

local state = {
	screen = "lobby",
	game_id = nil,
	join_code = nil,
	game = {},
	selected = {},
	guest_name = "Player",
	join_input = "",
	status = "Login as guest to begin",
}

local ui = {
	buttons = {},
	labels = {},
	root = nil,
	-- Last-created nodes are on top; test pick in reverse for overlaps.
	pick_order = {},
}

-- Must match [display] in game.project. Layout is authored in reference space 960×640 then
-- scaled uniformly into this canvas: px(n) = n * min(DESIGN_W/960, DESIGN_H/640).
local DESIGN_REF_W, DESIGN_REF_H = 960, 640
local DESIGN_W, DESIGN_H = 900, 800
local LAYOUT_UNIT = math.min(DESIGN_W / DESIGN_REF_W, DESIGN_H / DESIGN_REF_H)
local FONT_BOOST = 1.0

local function px(n)
	return n * LAYOUT_UNIT
end

local function window_logical_size()
	local wok, ws, hs = pcall(window.get_size)
	if not wok or not ws or ws <= 0 then
		return nil, nil
	end
	local ds = 1
	local ok_ds, v = pcall(window.get_display_scale)
	if ok_ds and v and v > 0 then
		ds = v
	end
	return ws / ds, hs / ds
end

local function apply_gui_root_scale()
	if not ui.root then
		return
	end
	local lw, lh = window_logical_size()
	if not lw then
		dlog("apply_gui_root_scale skip (no window size yet)")
		return
	end
	local s = math.min(lw / DESIGN_W, lh / DESIGN_H)
	-- Never scale up: clips against the GUI scene. ADJUST_* on root is off (see init).
	if s < 1 then
		gui.set_scale(ui.root, vmath.vector3(s, s, 1))
	else
		gui.set_scale(ui.root, vmath.vector3(1, 1, 1))
	end
	local sc = gui.get_scale(ui.root)
	dlog("apply_gui_root_scale", "window_log", lw, lh, "s_raw", s, "root_scale", sc.x, sc.y, "scene", gui.get_width(), gui.get_height())
end

local function set_status(text)
	state.status = text or ""
	if ui.labels.status then
		gui.set_text(ui.labels.status, state.status)
	end
end

local function clear_ui()
	local to_remove = {}
	for box, _ in pairs(ui.buttons) do
		to_remove[#to_remove + 1] = box
	end
	for _, box in ipairs(to_remove) do
		gui.delete_node(box)
	end
	ui.buttons = {}
	for _, n in pairs(ui.labels) do
		if n then
			gui.delete_node(n)
		end
	end
	ui.labels = {}
	ui.pick_order = {}
	dlog("clear_ui", "done")
end

local function make_label(key, x, y, text, scale)
	local n = gui.new_text_node(vmath.vector3(x, y, 0), text or "")
	gui.set_parent(n, ui.root)
	gui.set_font(n, hash("system_font"))
	-- Default text color is dark; clear color is usually black — invisible without this.
	gui.set_color(n, vmath.vector4(1, 1, 1, 1))
	gui.set_scale(n, vmath.vector3((scale or 1) * FONT_BOOST, (scale or 1) * FONT_BOOST, 1))
	ui.labels[key] = n
	return n
end

local function make_button(id, x, y, w, h, text, fn)
	local box = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
	gui.set_parent(box, ui.root)
	gui.set_color(box, vmath.vector4(0.22, 0.42, 0.62, 1))
	local label = gui.new_text_node(vmath.vector3(0, -px(4), 0), text)
	gui.set_parent(label, box)
	gui.set_font(label, hash("system_font"))
	gui.set_color(label, vmath.vector4(1, 1, 1, 1))
	gui.set_scale(label, vmath.vector3(0.9 * FONT_BOOST, 0.9 * FONT_BOOST, 1))
	ui.buttons[box] = { id = id, fn = fn, label = label, box = box }
	table.insert(ui.pick_order, box)
	return box
end

-- Simple “card” tile (no raster assets; Defold does not use SVG for sprites).
local function make_card_button(card, x, y, selected, fn)
	local w, h = px(72), px(96)
	local box = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
	gui.set_parent(box, ui.root)
	if selected then
		gui.set_color(box, vmath.vector4(0.42, 0.62, 0.92, 1))
	else
		gui.set_color(box, vmath.vector4(0.94, 0.94, 0.97, 1))
	end
	local label = gui.new_text_node(vmath.vector3(0, -px(8), 0), tostring(card))
	gui.set_parent(label, box)
	gui.set_font(label, hash("system_font"))
	gui.set_color(label, vmath.vector4(0.08, 0.08, 0.1, 1))
	gui.set_scale(label, vmath.vector3(0.64 * FONT_BOOST, 0.64 * FONT_BOOST, 1))
	ui.buttons[box] = { id = "card_" .. tostring(card), fn = fn, label = label, box = box }
	table.insert(ui.pick_order, box)
	return box
end

local function top_discard(pile)
	if not pile or #pile == 0 then
		return "—"
	end
	return pile[#pile]
end

local function format_scores(scores)
	if not scores then return "Scores: —" end
	local parts = {}
	for pid, val in pairs(scores) do
		table.insert(parts, pid:sub(1, 6) .. "=" .. tostring(val))
	end
	return "Scores: " .. table.concat(parts, "  ")
end

local function format_req(req)
	if not req then return "Round req: —" end
	local parts = {}
	for pid, met in pairs(req) do
		table.insert(parts, pid:sub(1, 6) .. "=" .. (met and "yes" or "no"))
	end
	return "Round req met: " .. table.concat(parts, "  ")
end

local function selected_cards()
	local out = {}
	for card, on in pairs(state.selected) do
		if on then table.insert(out, card) end
	end
	return out
end

local function card_list(hand)
	if not hand or #hand == 0 then
		return "(empty hand)"
	end
	return table.concat(hand, "  ")
end

local function rebuild_game()
	clear_ui()
	local g = state.game
	make_label("title", px(480), px(610), "Round " .. tostring(g.round or "?") .. "  Phase: " .. tostring(g.phase or "?"), 1.1)
	ui.labels.status = make_label("status", px(480), px(580), state.status, 0.8)

	local turn = g.currentTurn or "?"
	local mine = api.player_id or "?"
	make_label("turn", px(480), px(550), "Turn: " .. turn .. (turn == mine and " (you)" or ""), 0.9)

	make_label("hand", px(480), px(500), "Hand: " .. card_list(g.myHand), 0.76)
	make_label("discard", px(480), px(460), "Discard top: " .. top_discard(g.discardPile), 0.76)
	make_label("scores", px(480), px(430), format_scores(g.totalScores), 0.7)
	make_label("req", px(480), px(400), format_req(g.roundReqMet), 0.7)

	local y = px(340)
	if g.phase == "draw" and g.currentTurn == api.player_id then
		make_button("draw_deck", px(280), y, px(160), px(40), "Draw deck", function()
			ws.send({ type = "draw_card", from = "deck" })
		end)
		make_button("draw_disc", px(480), y, px(160), px(40), "Draw discard", function()
			ws.send({ type = "draw_card", from = "discard" })
		end)
	end

	if g.phase == "meld" and g.currentTurn == api.player_id then
		make_button("meld", px(280), y, px(160), px(40), "Lay meld (sel)", function()
			local cards = selected_cards()
			if #cards < 3 then
				set_status("Select 3+ cards in hand list (tap cards)")
				return
			end
			ws.send({ type = "lay_meld", cards = cards })
			state.selected = {}
		end)
		make_button("discard", px(480), y, px(160), px(40), "Discard (sel)", function()
			local cards = selected_cards()
			if #cards ~= 1 then
				set_status("Select exactly 1 card to discard")
				return
			end
			ws.send({ type = "discard", card = cards[1] })
			state.selected = {}
		end)
	end

	if g.phase == "offer" and g.offer then
		make_label("offer", px(480), y + px(40), "Offered: " .. tostring(g.offer.card), 1.0)
		make_button("accept", px(320), y, px(140), px(40), "Accept", function()
			ws.send({ type = "accept_offer" })
		end)
		make_button("decline", px(520), y, px(140), px(40), "Decline", function()
			ws.send({ type = "decline_offer" })
		end)
	end

	-- Hand card toggles (light tiles; add atlas PNGs later if you want illustrated faces).
	local hand = g.myHand or {}
	local start_x = px(108)
	for i, card in ipairs(hand) do
		local cx = start_x + ((i - 1) % 8) * px(80)
		local cy = px(148) - math.floor((i - 1) / 8) * px(108)
		local sel = state.selected[card]
		make_card_button(card, cx, cy, sel, function()
			if state.selected[card] then
				state.selected[card] = nil
			else
				state.selected[card] = true
			end
			rebuild_game()
		end)
	end

	make_button("lobby", px(860), px(40), px(120), px(36), "Lobby", function()
		ws.disconnect()
		state.screen = "lobby"
		rebuild_lobby()
	end)
	local label_n = 0
	for _ in pairs(ui.labels) do
		label_n = label_n + 1
	end
	dlog("rebuild_game", "phase", tostring(g.phase), "round", tostring(g.round), "pickables", #ui.pick_order, "labels", label_n)
	apply_gui_root_scale()
end

local function apply_server_msg(msg)
	if msg.type == "error" or msg.code then
		dlog("apply_server_msg error", tostring(msg.message or msg.code))
		set_status(tostring(msg.message or msg.code or "error"))
		return
	end
	if msg.type == "game_state" then
		dlog("apply_server_msg", "game_state", "phase", tostring(msg.phase), "hand_n", #(msg.myHand or {}))
		state.game = msg
		state.screen = "game"
		rebuild_game()
		return
	end
	-- Delta events — refresh labels; full state follows on game_state.
	if msg.type == "round_ended" or msg.type == "game_ended" then
		dlog("apply_server_msg", msg.type, "winnerId", tostring(msg.winnerId))
		set_status(msg.type .. " winner=" .. tostring(msg.winnerId))
	end
	if msg.type == "game_suspended" then
		dlog("apply_server_msg game_suspended", tostring(msg.reason))
		set_status("Game suspended: " .. tostring(msg.reason))
	end
end

local function connect_and_play()
	if not state.game_id or not api.token then
		set_status("Need game id + login")
		return
	end
	if not ws.available() then
		set_status("Install extension-websocket (see README)")
		return
	end
	local url = api.ws_url(state.game_id)
	dlog("connect_and_play", "game_id", tostring(state.game_id))
	set_status("Connecting WS…")
	ws.disconnect()
	local ok, err = ws.connect(url, apply_server_msg, function()
		dlog("ws on_connected")
		set_status("Connected")
	end, function()
		dlog("ws on_disconnected")
		set_status("Disconnected")
	end)
	if not ok then
		dlog("connect_and_play failed", tostring(err))
		set_status(err)
	else
		dlog("connect_and_play ws.connect returned ok=true (async callbacks follow)")
	end
end

local function rebuild_lobby()
	clear_ui()
	make_label("title", px(480), px(600), "Žolíky", 1.5)
	ui.labels.status = make_label("status", px(480), px(560), state.status, 0.9)
	make_label("hint", px(480), px(40), "Server: " .. api.base_url, 0.7)

	make_button("guest", px(200), px(480), px(200), px(44), "Guest login", function()
		set_status("Logging in…")
		api.guest_login(state.guest_name, function(err)
			if err then
				set_status("Login failed: " .. tostring(err))
				return
			end
			set_status("Logged in. Create or join a game.")
		end)
	end)

	make_button("create", px(480), px(480), px(200), px(44), "Create game", function()
		if not api.token then
			set_status("Login first")
			return
		end
		set_status("Creating game…")
		api.create_game(function(err, data)
			if err then
				set_status(err)
				return
			end
			state.game_id = data.gameId
			state.join_code = data.joinCode
			set_status("Created " .. state.join_code .. " — add AI and start")
			rebuild_lobby()
		end)
	end)

	make_button("join", px(760), px(480), px(200), px(44), "Join game", function()
		if not api.token then
			set_status("Login first")
			return
		end
		local code = state.join_input
		if code == "" then
			set_status("Enter join code or game id")
			return
		end
		set_status("Joining…")
		api.join_game(code, function(err, data)
			if err then
				set_status(err)
				return
			end
			state.game_id = data.gameId
			set_status("Joined game " .. state.game_id)
			rebuild_lobby()
		end)
	end)

	make_button("join_cycle", px(760), px(420), px(200), px(36), "Join code: " .. (state.join_input ~= "" and state.join_input or "(tap)"), function()
		local samples = { "ABC123", state.join_code or "", "paste-id" }
		state.join_input = samples[((#state.join_input) % #samples) + 1]
		rebuild_lobby()
	end)

	if state.game_id then
		make_label("gid", px(480), px(430), "Game: " .. state.game_id, 0.8)
		make_label("code", px(480), px(400), "Join code: " .. tostring(state.join_code), 0.8)
		make_button("ai", px(320), px(340), px(140), px(40), "Add AI", function()
			api.add_ai(state.game_id, "medium", function(err)
				set_status(err or "AI added")
			end)
		end)
		make_button("start", px(480), px(340), px(140), px(40), "Start", function()
			api.start_game(state.game_id, function(err)
				if err then
					set_status(err)
					return
				end
				connect_and_play()
			end)
		end)
		make_button("play", px(640), px(340), px(140), px(40), "Connect WS", function()
			connect_and_play()
		end)
	end
	local label_n = 0
	for _ in pairs(ui.labels) do
		label_n = label_n + 1
	end
	dlog("rebuild_lobby", "game_id", tostring(state.game_id), "pickables", #ui.pick_order, "labels", label_n)
	apply_gui_root_scale()
end

function init(self)
	dlog("init start")
	msg.post(".", "acquire_input_focus")
	api.base_url = sys.get_config("zolik.base_url") or "http://127.0.0.1:8090"
	dlog("init base_url", api.base_url)
	ui.root = gui.get_node("root")
	log_display("init")
	local rp = gui.get_position(ui.root)
	local rs = gui.get_size(ui.root)
	dlog("init root", "pos", rp.x, rp.y, "size", rs.x, rs.y, "adjust_mode", gui.get_adjust_mode(ui.root))
	-- ADJUST_FIT + ADJUST_REFERENCE_PARENT scales root to the physical window (e.g. 2× on Retina) and clips the scene — same bug as the huge-window era. Keep root at 1:1 with [display].
	gui.set_adjust_mode(ui.root, gui.ADJUST_NONE)
	pcall(function()
		window.set_size(DESIGN_W, DESIGN_H)
	end)
	gui.set_color(ui.root, vmath.vector4(0.14, 0.14, 0.16, 1))
	rebuild_lobby()
	apply_gui_root_scale()
	timer.delay(0, false, function()
		log_display("deferred_frame0")
		apply_gui_root_scale()
		local sc = gui.get_scale(ui.root)
		dlog("deferred_frame0 root_scale", sc.x, sc.y)
	end)
	dlog("init done")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("server_msg") then
		apply_server_msg(message)
	end
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return
	end
	-- gui.pick_node(node, x, y) -> boolean (Defold stable API; not pick_node(vector)).
	local x = action.screen_x or action.x
	local y = action.screen_y or action.y
	dlog("touch", "x", x, "y", y, "action.x", action.x, "action.y", action.y, "screen_x", action.screen_x, "screen_y", action.screen_y, "pickables", #ui.pick_order)
	for i = #ui.pick_order, 1, -1 do
		local box = ui.pick_order[i]
		local b = ui.buttons[box]
		if b and b.fn and gui.pick_node(box, x, y) then
			dlog("pick hit", tostring(b.id), "index", i)
			b.fn()
			return
		end
	end
	dlog("pick miss (no button bounds contained the point)")
end
