APP_ENV=local
PORT=8090

# Mongo
MONGO_URI=mongodb://mongo:27017
MONGO_DB=zolik

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Cross-instance WebSocket fan-out. Required when running multiple app
# containers (see docker-compose app + app2).
#
# Setting it makes Redis *required*: unreachable means the server refuses to
# start. Left unset, local development tries redis://localhost:6379/0 and
# quietly carries on local-only if nothing answers. Set it to empty to opt out
# of Redis entirely.
REDIS_URL=redis://redis:6379/0
# INSTANCE_ID=app-1

# SSH terminal client (client-tui). Off unless set: it binds a second port,
# which a second server on the same machine would collide on.
SSH_ENABLED=true
SSH_PORT=2222
SSH_HOST_KEY_PATH=.ssh/zolik_host_key
SSH_ALLOW_ALL_KEYS=true


# Public URL, and where a browser sign-in may return to (open-redirect
# allow-list). Defaults to http://localhost:$PORT and the app's deep-link
# scheme, which is fine for local dev.
# PUBLIC_BASE_URL=https://api.example.com
# AUTH_ALLOWED_RETURN_URLS=clientreactnative://,https://api.example.com

# Passwordless email sign-in. Without SMTP_HOST, codes are logged instead of
# mailed (local dev only — any other APP_ENV refuses to start without one).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=Žolíky

# Google / Apple / Microsoft sign-in. Each is enabled independently by
# setting its client id — leave a provider's variables unset to omit it
# entirely from /auth/providers.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_EXTRA_AUDIENCES=            # comma-separated iOS/Android client ids

# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY=                 # .p8 contents, or a path to the file

# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=common

# Admin console at /admin. Comma-separated addresses; a caller must be signed
# in with a *verified* address on this list. Unset means nobody gets in, which
# is the intended default — see README.md "Admin console".
# ADMIN_EMAILS=you@example.com
