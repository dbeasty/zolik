APP_ENV=local
PORT=8090

# Storage engine. "mongo" (default) uses the compose stack's MongoDB below;
# "kdb" embeds the KDB engine in-process — no database server, no Redis
# (docker-compose.kdb.yml is the one-container stack built around it).
# FEATURE_FLAG_DB_ENGINE=kdb
# KDB_PATH=data/kdb

# Mongo
MONGO_URI=mongodb://mongo:27017
MONGO_DB=zolik

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Cross-instance WebSocket fan-out (leave unset for single-process dev without Docker Redis).
# Required when running multiple app containers (see docker-compose app + app2).
REDIS_URL=redis://redis:6379/0
# INSTANCE_ID=app-1

# SSH terminal client (client-tui)
SSH_ENABLED=true
SSH_PORT=2222
SSH_HOST_KEY_PATH=.ssh/zolik_host_key
SSH_ALLOW_ALL_KEYS=true


# Public URL, and where a browser sign-in may return to (open-redirect
# allow-list). Defaults to http://localhost:$PORT and the app's deep-link
# scheme, which is fine for local dev.
# PUBLIC_BASE_URL=https://api.example.com
# AUTH_ALLOWED_RETURN_URLS=clientreactnative://,https://api.example.com

# Passwordless email sign-in. Without SMTP_HOST, codes are logged instead of
# mailed (local dev only — any other APP_ENV refuses to start without one).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=Žolíky

# Google / Apple / Microsoft sign-in. Each is enabled independently by
# setting its client id — leave a provider's variables unset to omit it
# entirely from /auth/providers.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_EXTRA_AUDIENCES=            # comma-separated iOS/Android client ids

# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY=                 # .p8 contents, or a path to the file

# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=common

# Admission control — refuse new connections before the process hits its
# memory limit or CPU stalls. On hosts with no readable cgroup limit (typical
# dev machines) and no PSI file, the gates self-disable and nothing changes.
# ADMISSION_MAX_CONNECTIONS=0          # 0 = derive from memory limit; -1 = off
# ADMISSION_WAITING_ROOM_RATIO=0.8     # close the waiting room at 80% of ceiling
# ADMISSION_MEMORY_WATERMARK=0.85      # stop admitting at 85% of cgroup memory
# ADMISSION_CPU_WATERMARK=0.25         # PSI some avg10; sheds waiting room + new matches only
