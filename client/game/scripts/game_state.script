local M = {}

local state = {}

local function ensureMaps()
	state.melds = state.melds or {}
	state.roundReqMet = state.roundReqMet or {}
end

function on_message(self, message_id, message, sender)
	local t = tostring(message_id)

	if t == "game_state" then
		state = message
		ensureMaps()
		msg.post("/game#table", "render_state", state)
		msg.post("/game#hand", "render_hand", { cards = state.myHand or {} })
		msg.post("/game#hud", "render_hud", state)

	elseif t == "discard_offered" then
		msg.post("/game#hud", "show_offer", { card = message.card })

	elseif t == "offer_resolved" then
		msg.post("/game#hud", "hide_offer")
		msg.post("/game#table", "update_discard", state.discardPile)

	elseif t == "reshuffle" then
		state.discardPile = {}
		state.reshuffleCount = (state.reshuffleCount or 0) + 1
		msg.post("/game#table", "update_discard", state.discardPile)
		msg.post("/game#hud", "show_reshuffle_notice", { count = state.reshuffleCount })

	elseif t == "meld_played" then
		state.melds[message.playerId] = state.melds[message.playerId] or {}
		table.insert(state.melds[message.playerId], {
			id = message.meldId,
			cards = message.cards,
			type = message.meldType
		})
		msg.post("/game#table", "render_melds", state.melds)

	elseif t == "card_laid_off" then
		msg.post("/game#table", "render_melds", state.melds)

	elseif t == "player_discarded" then
		table.insert(state.discardPile, message.card)
		msg.post("/game#table", "update_discard", state.discardPile)
		msg.post("/game#hud", "advance_turn", { currentTurn = state.currentTurn })

	elseif t == "round_ended" then
		msg.post("/ui#scores", "show_round_scores", message)

	elseif t == "game_ended" then
		msg.post("/ui#scores", "show_final_scores", message)

	elseif t == "game_suspended" then
		msg.post("/game#hud", "show_suspended", message)

	elseif t == "game_resumed" then
		msg.post("/game#hud", "hide_suspended")

	elseif t == "error" then
		msg.post("/game#hud", "show_error", { code = message.code, text = message.message })
	end
end

return M

