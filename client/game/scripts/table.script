local M = {}

local discard_nodes = {}
local meld_nodes = {}

function init(self)
end

local function clear_nodes(nodes)
	for _, n in ipairs(nodes) do
		if n and n.go then
			go.delete(n.go)
		end
	end
end

function on_message(self, message_id, message, sender)
	local t = tostring(message_id)
	if t == "render_state" then
		msg.post(".", "update_discard", { discardPile = message.discardPile })
	elseif t == "update_discard" then
		-- v1 placeholder: HUD/table rendering handled in GUI later
		-- Discard pile is visible from state.discardPile
	elseif t == "render_melds" then
		-- v1 placeholder
	end
end

return M

